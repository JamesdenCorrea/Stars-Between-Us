{
    "compilerOptions": {
        "allowJs": true,
        "lib": [
            "deno.window"
        ],
        "strict": true,
        "types": [
            "https://deno.land/x/types/deno.d.ts"
        ]
    },
    "lint": {
        "rules": {
            "tags": [
                "recommended"
            ],
            "include": [
                "camelcase"
            ],
            "exclude": [
                "no-explicit-any"
            ]
        }
    }
}